# Exact comma-separated frontend origins.
# Replace these with the production HTTPS origin when deploying.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://localhost

# Optional upstream API overrides:
# QURAN_API_BASE=https://api.quran.com/api/v4
# QDC_API_BASE=https://api.qurancdn.com/api/qdc

# Optional ZIP archive path for /api/download/project:
# PROJECT_ARCHIVE_PATH=/absolute/path/to/athar-kareem.zip

# Quran Foundation Content Sync (backend only; never expose these in the APK)
QF_CLIENT_ID=
QF_CLIENT_SECRET=
QF_ENV=production
